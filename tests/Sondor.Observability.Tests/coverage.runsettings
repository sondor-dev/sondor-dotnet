<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- The gate measures the package this project tests, not the OpenTelemetry SDK or the packages it builds on. -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Include>[Sondor.Observability]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
