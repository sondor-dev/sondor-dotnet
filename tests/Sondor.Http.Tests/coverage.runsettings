<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- The gate measures the package this project tests. Sondor.AspNetCore is only referenced here, as the real server side of the
       wire contract, and has its own tests and its own gate. -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Include>[Sondor.Http]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
