<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- The gate measures the package this project tests. Sondor.Cqrs.Results is only referenced here, to prove the two work together,
       and has its own tests and its own gate. -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Exclude>[Sondor.Cqrs.Results]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
