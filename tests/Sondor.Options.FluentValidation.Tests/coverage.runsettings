<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- The gate measures the package this project tests. Sondor.Options is a released package here, not a project, so it is not measured. -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Exclude>[Sondor.Options]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
