<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <MinVerTagPrefix>observability-v</MinVerTagPrefix>
    <Description>OpenTelemetry for services, configured from configuration: tracing, metrics and logging with one consistent resource, a required service name, safe defaults, and sampling and signals you can change while the service runs. OTLP export is built in; any other exporter plugs in through the builder.</Description>
    <PackageTags>opentelemetry;observability;tracing;metrics;logging;otlp;sampling;appconfiguration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <!-- A released version, not a project reference (see Sondor.Options.FluentValidation). -->
    <PackageReference Include="Sondor.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sondor.Observability.Tests" />
  </ItemGroup>

</Project>
